@@ -169,0 +189,4 @@ static void spawn_thread(ThreadPool *pool)
+        fprintf(stderr,
+                "LEANOS_TP schedule-spawn-bh pool=%p bh=%p cur=%d new=%d\n",
+                pool, pool->new_thread_bh, pool->cur_threads,
+                pool->new_threads);
@@ -178,0 +202 @@ static void thread_pool_completion_bh(void *opaque)
+    fprintf(stderr, "LEANOS_TP completion-bh-enter pool=%p\n", pool);
@@ -261,0 +286,5 @@ BlockAIOCB *thread_pool_submit_aio(ThreadPoolFunc *func, void *arg,
+    fprintf(stderr,
+            "LEANOS_TP submit-locked pool=%p req=%p idle=%d cur=%d "
+            "pending=%d new=%d\n",
+            pool, req, pool->idle_threads, pool->cur_threads,
+            pool->pending_threads, pool->new_threads);
@@ -265,0 +295 @@ BlockAIOCB *thread_pool_submit_aio(ThreadPoolFunc *func, void *arg,
+    fprintf(stderr, "LEANOS_TP submit-enqueued pool=%p req=%p\n", pool, req);
