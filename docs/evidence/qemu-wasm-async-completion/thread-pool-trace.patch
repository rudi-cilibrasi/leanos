+            "LEANOS_TP pthread-create-before pool=%p pending=%d cur=%d\n",
+            pool, pool->pending_threads, pool->cur_threads);
@@ -146,0 +163 @@ static void do_spawn_thread(ThreadPool *pool)
+    fprintf(stderr, "LEANOS_TP pthread-create-after pool=%p\n", pool);
@@ -152,0 +170 @@ static void spawn_thread_bh_fn(void *opaque)
