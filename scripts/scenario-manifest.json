{
  "schema": "leanos-scenario-manifest-v1",
  "families": {
    "fast-entry": {
      "description": "Fast-entry denial boot images; the matrix row is derived from the scenario id.",
      "row": {
        "runner": "boot",
        "timeout": "30",
        "image": "leanos-@VERSION@-x86_64-{id}.iso",
        "elf": "leanos-{id}.elf",
        "serial_log": "{id}.serial.log",
        "scenario": "{id}",
        "mode": "-",
        "reason": "-"
      }
    },
    "fast-entry-relaxation": {
      "description": "Return-path relaxation of one fast-entry control word; the mode is the corruption selector and the reason names the read-back that catches it.",
      "row": {
        "runner": "return",
        "timeout": "30",
        "image": "leanos-@VERSION@-x86_64-{id}.iso",
        "elf": "leanos-{id}.elf",
        "serial_log": "return-corruption-{scenario}.serial.log",
        "scenario": "{id|strip:return-}",
        "mode": "{mode}",
        "reason": "{reason}"
      }
    },
    "fault-integrity": {
      "description": "Page-table integrity fail-stop probes; the reason names the exact disagreement.",
      "row": {
        "runner": "fault-integrity",
        "timeout": "30",
        "image": "leanos-@VERSION@-x86_64-{id}.iso",
        "elf": "leanos-{id}.elf",
        "serial_log": "{id}.serial.log",
        "scenario": "{id|strip:fault-}",
        "mode": "-",
        "reason": "{reason}"
      }
    }
  },
  "artifact_kinds": {
    "iso": {
      "source": "{image}",
      "release": "{image}"
    },
    "elf": {
      "source": "{elf}",
      "release": "leanos-@VERSION@-x86_64{elf_suffix}.elf"
    },
    "map": {
      "source": "{elf_stem}.map",
      "release": "leanos-@VERSION@-x86_64{elf_suffix}.map"
    },
    "serial-log": {
      "source": "{serial_log}",
      "release": "leanos-@VERSION@{stem_dash}serial.log"
    },
    "disassembly": {
      "source": "{stem}.disassembly.txt",
      "release": "leanos-@VERSION@-{stem}-disassembly.txt"
    },
    "policy-report": {
      "source": "{stem}-policy-report.txt",
      "release": "leanos-@VERSION@-{stem}-policy-report.txt"
    },
    "snapshot": {
      "source": "{stem}-snapshot.txt",
      "release": "leanos-@VERSION@-{stem}-snapshot.txt"
    },
    "terminal": {
      "source": "{stem}-terminal.txt",
      "release": "leanos-@VERSION@-{stem}-terminal.txt"
    },
    "page-plan": {
      "source": "boot-page-plan-{stem}.final.h",
      "release": "leanos-@VERSION@-{stem}-page-plan.h"
    },
    "dma-snapshot": {
      "source": "dma-quarantine-snapshot-{scenario}.tsv",
      "release": "leanos-@VERSION@-dma-quarantine-snapshot.tsv"
    }
  },
  "release_extras": [
    {
      "source": "corpus.tsv",
      "release": "leanos-@VERSION@-oracle.tsv"
    },
    {
      "source": "SOURCE_REVISION",
      "release": "SOURCE_REVISION"
    },
    {
      "source": "TOOLCHAIN_PROFILE.json",
      "release": "TOOLCHAIN_PROFILE.json"
    }
  ],
  "reproducibility_extras": [
    "SOURCE_REVISION",
    "TOOLCHAIN_PROFILE.json"
  ],
