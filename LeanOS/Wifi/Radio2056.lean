  phyAnd 0x78 rfccOePorForce
  phyOr 0x78 ((~~~rfccOePorForce) &&& 0xFFFF)
  phyOr 0x78 rfccChip0Pu

/-- `wlc_phy_init_radio_regs` (phy_cmn.c:914-946) for a 2.4 GHz chanspec:
write `init_g` of every row with `do_init_g`, OR-ing in the core offset,
up to (not including) the 0xFFFF terminator (the C do/while always handles
row 0). `BRCMS_PHY_WAR_PR51571` is empty for N-PHY rev >= 3. -/
def wlcPhyInitRadioRegs (rows : Array RadioRegRow) (coreOffset : UInt32) : ProgM Unit := do
  for h : i in [0:rows.size] do
    let r := rows[i]
    if i > 0 && r.address == 0xFFFF then break
    if r.doInitG != 0 then radioWrite (r.address ||| coreOffset) (r.initG &&& 0xFFFF)

/-- `wlc_phy_radio_init_2056` (phy_n.c:19976-20037), radio rev 11:
`regs_SYN_2056_rev11`, `regs_TX_2056_rev11`, `regs_RX_2056_rev11`. -/
def wlcPhyRadioInit2056 (syn tx rx : Array RadioRegRow) : ProgM Unit := do
  wlcPhyInitRadioRegs syn coreSyn
  wlcPhyInitRadioRegs tx coreTx0
  wlcPhyInitRadioRegs tx coreTx1
  wlcPhyInitRadioRegs rx coreRx0
  wlcPhyInitRadioRegs rx coreRx1

/-- `wlc_phy_radio205x_rcal` (phy_n.c:19766-19872). Only N-PHY rev 3 (radio
2056) and rev >= 7 (radio 2057) do anything; for rev 4..6 it returns 0
without touching hardware, so nothing is emitted. -/
def wlcPhyRadio205xRcal : ProgM Unit := pure ()

/-- `wlc_phy_radio_postinit_2056` (phy_n.c:20039-20058); `phy_init_por` is
true on the first `wlc_phy_init`, so the (empty for rev 6) rcal is invoked. -/
def wlcPhyRadioPostinit2056 (cfg : PhyCfg) : ProgM Unit := do
  radioMod Reg.synComCtrl 0xb 0xb
  radioMod Reg.synComPu 0x2 0x2
  radioMod Reg.synComReset 0x2 0x2
  delay 1000
  radioMod Reg.synComReset 0x2 0x0
  if cfg.boardFlags2 &&& bfl2Legacy != 0 || cfg.boardFlags2 &&& bfl2XtalBufOutEn != 0 then
    radioMod Reg.synPllMast2 0xf4 0x0
  else
    radioMod Reg.synPllMast2 0xfc 0x0
  radioMod Reg.synRccalCtrl0 0x1 0x0
  wlcPhyRadio205xRcal

/-! ## Channel programming (wlc_phy_chanspec_set → wlc_phy_chanspec_set_nphy) -/

/-- `wlc_phy_radio205x_vcocal_nphy` (phy_n.c:20802-20819), rev 3..6. -/
def wlcPhyRadio205xVcocalNphy : ProgM Unit := do
  radioWrite Reg.synPllVcocal12 0x0
  radioWrite Reg.synPllMast3 0x38
  radioWrite Reg.synPllMast3 0x18
  radioWrite Reg.synPllMast3 0x38
  radioWrite Reg.synPllMast3 0x39
  delay 300

/-- `wlc_phy_chanspec_radio2056_setup` (phy_n.c:20472-20800) for 2.4 GHz. -/
def wlcPhyChanspecRadio2056Setup (cfg : PhyCfg) (ci : ChanInfo) (syn : Array RadioRegRow) :
    ProgM Unit := do
  let synRegs := #[Reg.synPllVcocal1, Reg.synPllVcocal2, Reg.synPllRefdiv, Reg.synPllMmd2,
    Reg.synPllMmd1, Reg.synPllLoopfilter1, Reg.synPllLoopfilter2, Reg.synPllLoopfilter3,
    Reg.synPllLoopfilter4, Reg.synPllLoopfilter5, Reg.synReservedAddr27,
    Reg.synReservedAddr28, Reg.synReservedAddr29, Reg.synLogenVcobuf1,
    Reg.synLogenMixer2, Reg.synLogenBuf3, Reg.synLogenBuf4]
  for h : k in [0:synRegs.size] do
    radioWrite (synRegs[k] ||| coreSyn) ci.syn[k]!
  -- RX lna tunes then the eight TX boost tunes, core 0 then core 1.
  let rxtxRegs := #[(Reg.rxLnaaTune, true), (Reg.rxLnagTune, true),
    (Reg.txIntpaaBoostTune, false), (Reg.txIntpagBoostTune, false),
    (Reg.txPadaBoostTune, false), (Reg.txPadgBoostTune, false),
    (Reg.txPgaaBoostTune, false), (Reg.txPgagBoostTune, false),
    (Reg.txMixaBoostTune, false), (Reg.txMixgBoostTune, false)]
  for (vals, rxCore, txCoreSel) in [(ci.rxtx0, coreRx0, coreTx0), (ci.rxtx1, coreRx1, coreTx1)] do
    for h : k in [0:rxtxRegs.size] do
      let (reg, isRx) := rxtxRegs[k]
      radioWrite (reg ||| (if isRx then rxCore else txCoreSel)) vals[k]!
  -- 2.4 GHz: PLL_CP2 from the radio rev 11 default table row 0x49 - 2.
  radioWrite (Reg.synPllCp2 ||| coreSyn) (syn[0x49 - 2]!.initG &&& 0xFFFF)
  if cfg.boardFlags2 &&& bfl2GpllWar != 0 then
    radioWrite (Reg.synPllLoopfilter1 ||| coreSyn) 0x1f
    radioWrite (Reg.synPllLoopfilter2 ||| coreSyn) 0x1f
    -- BCM43224 is neither 4716 nor 47162.
    radioWrite (Reg.synPllLoopfilter4 ||| coreSyn) 0xb
    radioWrite (Reg.synPllCp2 ||| coreSyn) 0x14
  if cfg.boardFlags2 &&& bfl2GpllWar2 != 0 then
    radioWrite (Reg.synPllLoopfilter1 ||| coreSyn) 0x1f
    radioWrite (Reg.synPllLoopfilter2 ||| coreSyn) 0x1f
    radioWrite (Reg.synPllLoopfilter4 ||| coreSyn) 0xb
    radioWrite (Reg.synPllCp2 ||| coreSyn) 0x20
  -- BFL2_APLL_WAR and the rev 6 iPA 5 GHz block apply to 5 GHz only.
  if cfg.ipa2g then
    for core in [0:2] do
      if cfg.phyRev >= 5 then
        radioWrite (Reg.txPadgIdac ||| txCore core) 0xcc
        -- BCM43224: not 4716/47162; SMIC-fab packages use a hotter bias.
        let smic := cfg.chipPkg == pkgBcm43224FabSmic
        let bias : UInt32 := if smic then 0x2a else 0x25
        let cascbias : UInt32 := if smic then 0x38 else 0x20
        radioWrite (Reg.txIntpagImainStat ||| txCore core) bias
        radioWrite (Reg.txIntpagIauxStat ||| txCore core) bias
        radioWrite (Reg.txIntpagCascbias ||| txCore core) cascbias
        radioWrite (Reg.txIntpagBoostTune ||| txCore core) 0x4
        radioWrite (Reg.txPgagBoostTune ||| txCore core) 0x03
        radioWrite (Reg.txPadgBoostTune ||| txCore core) 0x77
        radioWrite (Reg.txMixgBoostTune ||| txCore core) 0x65
      radioWrite (Reg.txPaSpare1 ||| txCore core) 0xee
  delay 50
  wlcPhyRadio205xVcocalNphy

/-- `wlc_phy_classifier_nphy` (phy_n.c:21292-21314) for D11 rev != 16 (no
MAC suspend): `0xb0[2:0] := (cur & ~mask) | (val & mask)`. Uses r0. -/
def wlcPhyClassifierNphy (mask val : UInt32) : ProgM Unit := do
  phyRead 0 0xb0
  andi 0 0x7
  andi 0 ((~~~mask) &&& 0xFFFF)
  ori 0 (val &&& mask)
  phyModR 0xb0 0x7 0

/-- `wlc_phy_txlpfbw_nphy` (phy_n.c:18859-18894), rev 3..6, 20 MHz. -/
def wlcPhyTxlpfbwNphy (cfg : PhyCfg) : ProgM Unit := do
  if cfg.phyRev >= 3 && cfg.phyRev < 7 then
    let bw : UInt32 := if cfg.ipa2g then 4 else 1
    phyWrite 0xe8 (bw ||| (bw <<< 3) ||| (bw <<< 6) ||| (bw <<< 9))
    if cfg.ipa2g then
      let bw2 : UInt32 := 1
      phyWrite 0xe9 (bw2 ||| (bw2 <<< 3) ||| (bw2 <<< 6) ||| (bw2 <<< 9))

/-- `wlc_phy_force_rfseq_nphy(pi, NPHY_RFSEQ_RESET2RX)` (phy_n.c:21316-21358).
The SPINWAIT (200 ms in 10 µs steps) is a bounded loop; a still-busy
sequencer is only reported, as brcmsmac's WARN does. Uses r1–r3. -/
def wlcPhyForceRfseqNphyReset2rx : ProgM Unit := do
  phyRead 1 0xa1
  phyOr 0xa1 (rfseqModeCoreActvOverride ||| rfseqModeTriggerOverride)
  phyOr 0xa3 rfseqTriggerReset2rx
  let top ← newLabel
  let done ← newLabel
  li 3 20000
  place top
  phyRead 2 0xa4
  andi 2 rfseqStatusReset2rx
  emit (.branch .eq 2 (.imm 0) done)
  delay 10
  emit (.alu .sub 3 (.imm 1))
  emit (.branch .ne 3 (.imm 0) top)
  place done
  phyWriteR 0xa1 1
  phyRead 2 0xa4
  andi 2 rfseqStatusReset2rx
  let ok ← newLabel
  emit (.branch .eq 2 (.imm 0) ok)
  print Tag.rfseqBusy 2
  place ok

/-- `wlc_phy_resetcca_nphy` (phy_n.c:19550-19564). Uses r1–r3. -/
def wlcPhyResetccaNphy : ProgM Unit := do
  brcmsBPhyclkFgc true
  phyRead 1 0x01
  mov 2 1
  ori 2 bbcfgResetCca
  phyWriteR 0x01 2
  delay 1
  mov 2 1
  andi 2 ((~~~bbcfgResetCca) &&& 0xFFFF)
  phyWriteR 0x01 2
  brcmsBPhyclkFgc false
  wlcPhyForceRfseqNphyReset2rx

/-- `wlc_phy_adjust_rx_analpfbw_nphy` (phy_n.c:18897-18922). Acts only on
channel 11 at 40 MHz, or to undo that adjustment; at 20 MHz the
`nphy_anarxlpf_adjusted` flag is never set, so nothing is emitted. -/
def wlcPhyAdjustRxAnalpfbwNphy : ProgM Unit := pure ()

/-- `wlc_phy_adjust_min_noisevar_nphy(pi, 0, NULL, NULL)` (phy_n.c:18924-18971):
restores saved noise variances only if `nphy_noisevars_adjusted`, which is
never set on this 20 MHz path; with no tones given nothing is written. -/
def wlcPhyAdjustMinNoisevarNphyNone : ProgM Unit := pure ()

/-- `wlc_phy_adjust_crsminpwr_nphy` (phy_n.c:18972-19022): channel 11 at
40 MHz only, or undoing it (`nphy_crsminpwr_adjusted`, never set at 20 MHz). -/
def wlcPhyAdjustCrsminpwrNphy : ProgM Unit := pure ()

/-- `wlc_phy_spurwar_nphy` (phy_n.c:19024-19194) for rev 6, 2.4 GHz, 20 MHz.
`phyhang_avoid` is false for rev 6; the gband spur-war calls are all
no-ops at 20 MHz (see above); spurwar2 and aband need boardflags2 bits. -/
def wlcPhySpurwarNphy (cfg : PhyCfg) : ProgM Unit := do
  if cfg.phyRev >= 3 then
    -- nphy_gband_spurwar_en (rev 3..6)
    if cfg.phyRev < 7 then
      wlcPhyAdjustRxAnalpfbwNphy
      wlcPhyAdjustMinNoisevarNphyNone
      wlcPhyAdjustCrsminpwrNphy
    -- nphy_gband_spurwar2_en at 20 MHz: isAdjustNoiseVar stays false.
    if cfg.phyRev == 6 && cfg.boardFlags2 &&& bfl2G2SpurWar != 0 then
      wlcPhyAdjustMinNoisevarNphyNone
    -- nphy_aband_spurwar_en applies to 5 GHz only.

/-- Spur-avoid mode chosen by `wlc_phy_chanspec_nphy_setup` for rev 3..6 at
20 MHz with `SPURAVOID_AUTO`. -/
def spurAvoidMode (cfg : PhyCfg) : Nat :=
  if (cfg.channel >= 5 && cfg.channel <= 8) || cfg.channel == 13 || cfg.channel == 14 then 1
  else 0

/-- `wlc_phy_chanspec_nphy_setup` (phy_n.c:21019-21152) for BCM43224,
2.4 GHz, 20 MHz, channels 1..13. Uses r0–r3. -/
def wlcPhyChanspecNphySetup (hooks : Hooks) (cfg : PhyCfg) (ci : ChanInfo) : ProgM Unit := do
  -- Leave 5 GHz mode if the PHY is still in it (run-time state).
  phyRead 1 0x09
  andi 1 bandControlCurrentBand
  ifEq 1 bandControlCurrentBand do
    phyAnd 0x09 ((~~~bandControlCurrentBand) &&& 0xFFFF)
    r16 1 d11PsmPhyHdrParam
    mov 2 1
    ori 2 macPhyForceClk
    emit (.write16 d11PsmPhyHdrParam (.reg 2))
    phyAnd (nphyToBphyOff + bphyBbConfig) (0xffff &&& ~~~(bbcfgResetCca ||| bbcfgResetRx))
    emit (.write16 d11PsmPhyHdrParam (.reg 1))
  let bwRegs : Array UInt32 := #[0x1ce, 0x1cf, 0x1d0, 0x1d1, 0x1d2, 0x1d3]
  for h : k in [0:bwRegs.size] do
    phyWrite bwRegs[k] ci.phyBw[k]!
  -- Channel 1..13 (never 14 here).
  wlcPhyClassifierNphy classifierCtrlOfdmEn classifierCtrlOfdmEn
  phyAnd (nphyToBphyOff + bphyTest) ((~~~(0x840 : UInt32)) &&& 0xFFFF)
  -- nphy_txpwrctrl is PHY_TPC_HW_ON (rev >= 3): no wlc_phy_txpwr_fixpower_nphy.
  -- rev >= 3: no wlc_phy_adjust_lnagaintbl_nphy.
  wlcPhyTxlpfbwNphy cfg
  -- phy_spuravoid == SPURAVOID_AUTO for rev 3..6.
  let spuravoid := spurAvoidMode cfg
  -- BCM43224 (not 4716/43225): PHY PLL off around the PMU PLL update.
  brcmsBCorePhypllCtl false
  hooks.pmuSpurAvoidPllUpdate spuravoid
  brcmsBCorePhypllCtl true
  if spuravoid == 1 then
    w16 d11TsfClkFracL 0x5341
    w16 d11TsfClkFracH 0x8
  else
    w16 d11TsfClkFracL 0x8889
    w16 d11TsfClkFracH 0x8
  brcmsBCorePhypllReset
  phyMod 0x01 0x8000 (if spuravoid > 0 then 0x8000 else 0)
  wlcPhyResetccaNphy
  if cfg.phyRev < 7 then
    phyWrite 0x17e 0x3830
  wlcPhySpurwarNphy cfg

/-- `wlc_phy_chanspec_set_nphy` (phy_n.c:21154-21229), rev 3..6, 2.4 GHz,
20 MHz: `pi->bw` is already 20 MHz so `wlapi_bmac_bw_set` is not called. -/
def wlcPhyChanspecSetNphy (hooks : Hooks) (cfg : PhyCfg) (ci : ChanInfo)
    (syn : Array RadioRegRow) : ProgM Unit := do
  radioMod (Reg.synComCtrl ||| coreSyn) 0x4 0
  wlcPhyChanspecRadio2056Setup cfg ci syn
  wlcPhyChanspecNphySetup hooks cfg ci

/-- `wlc_phy_chanspec_set` (phy_cmn.c:1112-1128): publish the channel in SHM
`M_CURCHANNEL` (2.4 GHz, 20 MHz: the bare channel number), then the N-PHY
channel set. -/
def wlcPhyChanspecSet (hooks : Hooks) (cfg : PhyCfg) (ci : ChanInfo)
    (syn : Array RadioRegRow) : ProgM Unit := do
  wlapiBmacWriteShm mCurChannel cfg.channel.toUInt32
  wlcPhyChanspecSetNphy hooks cfg ci syn

/-- Run `body` with the decoded tables, or emit the generation-time fail. -/
def withTables (cfg : PhyCfg)
    (body : ChanInfo → Array RadioRegRow → Array RadioRegRow → Array RadioRegRow → ProgM Unit) :
    ProgM Unit :=
  match validate cfg, chan2freq cfg.channel, synRows, txRows, rxRows with
  | none, some ci, some syn, some tx, some rx => body ci syn tx rx
  | some code, _, _, _, _ => fail code
  | none, _, _, _, _ => fail Fail.badChanTable

/-- `wlc_phy_chanspec_set` for `cfg.channel` (retune entry point). -/
def chanspecSetWith (hooks : Hooks) (cfg : PhyCfg) : ProgM Unit :=
  withTables cfg fun ci syn _ _ => wlcPhyChanspecSet hooks cfg ci syn

def chanspecSet (cfg : PhyCfg) : ProgM Unit := chanspecSetWith {} cfg

/-- `wlc_phy_switch_radio(pi, ON)` (phy_cmn.c:1057-1089) →
`wlc_phy_switch_radio_nphy` ON (phy_n.c:20139-20220) for N-PHY rev 3..6. -/
def radioOnWith (hooks : Hooks) (cfg : PhyCfg) : ProgM Unit :=
  withTables cfg fun ci syn tx rx => do
    r32 0 d11MacCtl
    wlcPhyRadioPreinit205x
    wlcPhyRadioInit2056 syn tx rx
    wlcPhyRadioPostinit2056 cfg
    wlcPhyChanspecSet hooks cfg ci syn

def radioOn (cfg : PhyCfg) : ProgM Unit := radioOnWith {} cfg

end LeanOS.Wifi.Radio2056
