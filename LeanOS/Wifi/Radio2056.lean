structure RadioRegRow where
  address : UInt32
  initA : UInt32
  initG : UInt32
  doInitA : UInt32
  doInitG : UInt32
  deriving Inhabited

/-- Decode a `radio_regs` table; `none` unless it has exactly `rows` rows,
every token parses, and the only 0xFFFF address is the final row. -/
def decodeRadioRegs (s : String) (rows : Nat) : Option (Array RadioRegRow) := Id.run do
  let w := hexU32s s
  if !hexU32sValid s || w.size != 5 * rows then return none
  let t := (Array.range rows).map fun i =>
    { address := w[5*i]!, initA := w[5*i+1]!, initG := w[5*i+2]!,
      doInitA := w[5*i+3]!, doInitG := w[5*i+4]! : RadioRegRow }
  let terms := t.filter (·.address == 0xFFFF)
  if terms.size != 1 || (t.back?.map (·.address)) != some 0xFFFF then return none
  return some t

def synRows : Option (Array RadioRegRow) := decodeRadioRegs regsSyn2056Rev11 182
def txRows : Option (Array RadioRegRow) := decodeRadioRegs regsTx2056Rev11 154
def rxRows : Option (Array RadioRegRow) := decodeRadioRegs regsRx2056Rev11 148

/-- Number of fields in `struct chan_info_nphy_radio205x`. -/
def chanInfoFields : Nat := 45

/-- One decoded `chan_info_nphy_radio205x` row. -/
structure ChanInfo where
  chan : Nat
  freq : Nat
  /-- RF_SYN_pll_vcocal1 .. RF_SYN_logen_BUF4 (17 bytes). -/
  syn : Array UInt32
  /-- Per TX/RX core: lnaa, lnag, intpaa, intpag, pada, padg, pgaa, pgag,
  mixa, mixg (10 bytes each). -/
  rxtx0 : Array UInt32
  rxtx1 : Array UInt32
  /-- PHY_BW1a, PHY_BW2 .. PHY_BW6 (`struct nphy_sfo_cfg`). -/
  phyBw : Array UInt32

/-- `wlc_phy_chan2freq_nphy` (phy_n.c:20223-20382) for N-PHY rev 5/6 and
radio rev 11: the row of `chan_info_nphyrev6_2056v11` for `channel`, or
`none` when the table is malformed or has no such channel. -/
def chan2freq (channel : Nat) : Option ChanInfo := Id.run do
  let s := chanInfoNphyrev62056v11G
  let w := hexU32s s
  if !hexU32sValid s || w.size != 14 * chanInfoFields then return none
  for i in [0:14] do
    let r := w.extract (i * chanInfoFields) ((i + 1) * chanInfoFields)
    if r[0]!.toNat == channel then
      return some { chan := channel, freq := r[1]!.toNat,
                    syn := r.extract 2 19, rxtx0 := r.extract 19 29,
                    rxtx1 := r.extract 29 39, phyBw := r.extract 39 45 }
  return none

/-- Generation-time check of the configuration and tables: the fail code to
emit instead of a program, if any. -/
def validate (cfg : PhyCfg) : Option UInt32 :=
  if !(cfg.phyRev == 5 || cfg.phyRev == 6) || cfg.radioRev != 11 then some Fail.unsupportedRev
  else if cfg.channel < 1 || cfg.channel > 13 then some Fail.badChannel
  else if synRows.isNone then some Fail.badSynTable
  else if txRows.isNone then some Fail.badTxTable
  else if rxRows.isNone then some Fail.badRxTable
  else match chan2freq cfg.channel with
    | none => some Fail.badChanTable
    | some ci =>
      -- `regs_SYN_2056_ptr[0x49 - 2]` must be the PLL_CP2 row, and the table
      -- frequency must agree with `CHSPEC_CHANNEL` → MHz.
      if (synRows.bind (·[0x49 - 2]?)).map (·.address) != some Reg.synPllCp2 then
        some Fail.badSynTable
      else if ci.freq != cfg.freqMHz then some Fail.badChanTable
      else none

/-! ## MAC-side shims (brcmsmac main.c, aiutils.c) -/

/-- `brcms_b_core_ioctl` (main.c:714-720): BCMA IOCTL `(v & ~m) | val`. -/
def brcmsBCoreIoctl (m v : UInt32) : ProgM Unit := maskSet32 wrapIoCtl (~~~m) v

/-- `brcms_b_phyclk_fgc` (main.c:1716-1727): SICF_FGC on/off (N-PHY). -/
def brcmsBPhyclkFgc (on : Bool) : ProgM Unit :=
  brcmsBCoreIoctl ioctlFgc (if on then ioctlFgc else 0)

/-- `ai_cc_reg` (aiutils.c:540-557): ChipCommon mask-and-set plus readback. -/
def aiCcReg (off mask val : UInt32) : ProgM Unit := do
  if mask != 0 || val != 0 then maskSet32 off (~~~mask) val
  r32 12 off

/-- `brcms_b_core_phypll_reset` (main.c:1697-1711): soft PHY PLL reset
through ChipCommon chipcontrol register 0 bit 2. -/
def brcmsBCorePhypllReset : ProgM Unit := do
  aiCcReg ccChipCtlAddr 0xFFFFFFFF 0
  delay 1
  aiCcReg ccChipCtlData 0x4 0
  delay 1
  aiCcReg ccChipCtlData 0x4 4
  delay 1
  aiCcReg ccChipCtlData 0x4 0
  delay 1

/-- `brcms_b_core_phypll_ctl` (main.c:2767-2818), non-4313 path. brcmsmac
spins up to `PHYPLL_WAIT_US` (100 ms, 10 µs steps) and only logs a timeout;
here a timeout fails with `Fail.phyPllTimeout`. Uses r13/r14. -/
def brcmsBCorePhypllCtl (on : Bool) : ProgM Unit := do
  if on then
    maskSet32 d11ClkCtlSt 0xFFFFFFFF (ccsErsrcReqD11Pll ||| ccsErsrcReqPhyPll)
    let avail := ccsErsrcAvailD11Pll ||| ccsErsrcAvailPhyPll
    poll32 d11ClkCtlSt avail avail 10000 10 Fail.phyPllTimeout
  else
    maskSet32 d11ClkCtlSt (~~~ccsErsrcReqPhyPll) 0
    r32 12 d11ClkCtlSt

/-- `brcms_b_write_shm` / `brcms_b_write_objmem` (main.c:2882-2912); on a
PCI host `bcma_wflush16` is a plain 16-bit write. -/
def wlapiBmacWriteShm (off v : UInt32) : ProgM Unit := shmWrite16 off v

/-- Pieces of this path that live outside brcmsmac. -/
structure Hooks where
  /-- `bcma_pmu_spuravoid_pllupdate(cc, spuravoid)`, called from
  `wlc_phy_chanspec_nphy_setup`. It is implemented in the GPL `bcma` driver,
  which this port must not copy, so no implementation is provided here. The
  default only reports the skipped update on the console
  (`Tag.pmuSpurAvoidSkipped`, value = spur-avoid mode) and continues. -/
  pmuSpurAvoidPllUpdate : Nat → ProgM Unit :=
    fun mode => printImm Tag.pmuSpurAvoidSkipped mode.toUInt32

