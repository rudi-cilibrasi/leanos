{
  "config": {
    "MD013": false
  },
  "ignores": [
    ".lake/**",
    "**/node_modules/**",
    // Local build outputs, such as scripts/check-quickproof.sh reports.
    "build/**",
    // Verbatim QuickProof reports (`qp check`, `qp verify`), kept as evidence.
    "experiments/quickproof/*/CHECK.md",
    "experiments/quickproof/*/VERIFY.md"
  ]
}
