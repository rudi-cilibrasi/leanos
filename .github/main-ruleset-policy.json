{
  "repository": "rudi-cilibrasi/leanos",
  "ruleset_id": 21871841,
  "ruleset": {
    "name": "main",
    "target": "branch",
    "enforcement": "active",
    "bypass_actors": [],
    "conditions": {
      "ref_name": {
        "include": [
          "~DEFAULT_BRANCH"
        ],
        "exclude": []
      }
    },
    "rules": [
      {
        "type": "deletion"
      },
      {
        "type": "non_fast_forward"
      },
      {
        "type": "pull_request",
        "parameters": {
          "allowed_merge_methods": [
            "merge",
            "squash",
            "rebase"
          ],
          "dismiss_stale_reviews_on_push": false,
          "require_code_owner_review": false,
          "require_extra_approval_for_unattributed_changes": false,
          "require_last_push_approval": false,
          "required_approving_review_count": 0,
          "required_review_thread_resolution": true,
          "required_reviewers": []
        }
      },
      {
        "type": "required_status_checks",
        "parameters": {
          "do_not_enforce_on_create": false,
          "required_status_checks": [
            {
              "context": "Clang canonical image evidence",
              "integration_id": 15368
            },
            {
              "context": "Clang cross-runner reproducibility",
              "integration_id": 15368
            },
            {
              "context": "Clang independent reproducibility build",
              "integration_id": 15368
            },
            {
              "context": "Deterministic QEMU smoke test (shard 0)",
              "integration_id": 15368
            },
            {
              "context": "Deterministic QEMU smoke test (shard 1)",
              "integration_id": 15368
            },
            {
              "context": "Deterministic QEMU smoke test (shard 2)",
              "integration_id": 15368
            },
            {
              "context": "Deterministic QEMU smoke test (shard 3)",
              "integration_id": 15368
            },
            {
              "context": "Hosted generated-boundary evidence",
              "integration_id": 15368
            },
            {
              "context": "Pre-merge full admission",
              "integration_id": 15368
            }
          ],
          "strict_required_status_checks_policy": true
        }
      }
    ]
  }
}
