# Lab-only BIOS/UEFI disk: i386-pc GRUB in the MBR and x86_64-efi GRUB at
# EFI/BOOT/BOOTX64.EFI both read this file. Persistent default is the existing
# FreeBSD disk.
# SSD-image variant: the LeanOS ELF, its SHA256 list and its digest live in
# /leanos on the FreeBSD disk's EFI system partition (gpt1), so images are
# updated from FreeBSD without touching this stick. The stick keeps GRUB, the
# one-shot request (grubenv) and the watchdog scripts.
insmod part_gpt
insmod part_msdos
insmod fat
insmod probe
insmod chain
insmod loadenv
serial --unit=0 --speed=38400 --word=8 --parity=no --stop=1
terminal_input console serial
terminal_output console serial
set timeout=0
set labroot=$root
# Locate the FreeBSD disk by its boot partition UUID; its gpt1 holds /leanos.
set leanosroot=none
set leanos_digest=missing
for disk in hd0 hd1 hd2 hd3; do
    set candidate=unknown
    if probe --set=candidate --part-uuid ($disk,gpt2); then
        if [ "$candidate" = "@FREEBSD_BOOT_UUID@" ]; then
            set leanosroot=($disk,gpt1)
        fi
    fi
done
if [ "$leanosroot" != "none" ]; then
    if [ -f $leanosroot/leanos/leanos-digest.cfg ]; then
        source $leanosroot/leanos/leanos-digest.cfg
    fi
fi
set request=none
load_env --file=($labroot)/boot/grub/grubenv request
set selected=$request
set request=none
if save_env --file=($labroot)/boot/grub/grubenv request; then
    if [ "$selected" = "none" ]; then
        echo 'LEANOS-LAB/1 DEFAULT request=none'
    fi
    if [ "$selected" = "leanos-${leanos_digest}" ]; then
        echo 'LEANOS-LAB/1 SELECT leanos consumed=1'
        if hashsum --hash sha256 --prefix $leanosroot/leanos --check $leanosroot/leanos/leanos.sha256; then
          if multiboot2 $leanosroot/leanos/leanos-qotom-lab.elf; then
            boot
          fi
        fi
        echo 'LEANOS-LAB/1 LOAD-FAILED fallback=freebsd'
    fi
    if [ "$selected" = "watchdog-test" ]; then
        # Physical testing repeated this request after a watchdog reset.
        # Disabled until durable consumption under that reset is established.
        echo 'LEANOS-LAB/1 WATCHDOG-DISABLED fallback=freebsd'
    fi
    insmod regexp
    set wd_prefix=watchdog-test
    set wd_image=none
    if [ "@KERNEL_HANG_ENABLED@" = "1" ]; then
        if regexp '^watchdog-kernel-' "$selected"; then
            set wd_prefix=watchdog-kernel-@KERNEL_HANG_SHA256@
            set wd_image=kernel
        fi
    fi
    if regexp '^watchdog-leanos-' "$selected"; then
        set wd_prefix=watchdog-leanos-${leanos_digest}
        set wd_image=leanos
    fi
    if regexp '^watchdog-(test|kernel|leanos)-' "$selected"; then
        if [ -f ($labroot)/boot/grub/watchdog-window.cfg ]; then
            source ($labroot)/boot/grub/watchdog-window.cfg
            if qotom_watchdog_window "$selected" "$wd_prefix"; then
                echo 'LEANOS-LAB/1 WATCHDOG-WINDOW accepted=1'
                if [ -f ($labroot)/boot/grub/watchdog.cfg ]; then
                    source ($labroot)/boot/grub/watchdog.cfg
                    if qotom_watchdog_arm; then
                        if [ "$wd_image" != "none" ]; then
                            if [ "$wd_image" = "kernel" ]; then
                                echo 'LEANOS-LAB/1 WATCHDOG-KERNEL-LOAD sha256=@KERNEL_HANG_SHA256@'
                                set wd_checksum=kernel-hang.sha256
                                set wd_elf=leanos-qotom-kernel-hang.elf
                            else
                                echo "LEANOS-LAB/1 WATCHDOG-LEANOS-LOAD sha256=${leanos_digest}"
                                set wd_checksum=leanos.sha256
                                set wd_elf=leanos-qotom-lab.elf
                            fi
                            if [ "$wd_image" = "leanos" ]; then
                                # SSD image: bare names in the list, resolved under /leanos.
                                if hashsum --hash sha256 --prefix $leanosroot/leanos --check $leanosroot/leanos/$wd_checksum; then
                                    if multiboot2 $leanosroot/leanos/$wd_elf; then
                                        boot
                                    fi
                                fi
                            else
                                if hashsum --hash sha256 --check ($labroot)/boot/$wd_checksum; then
                                    if multiboot2 ($labroot)/boot/$wd_elf; then
                                        boot
                                    fi
                                fi
                            fi
                            echo 'LEANOS-LAB/1 WATCHDOG-LOAD-FAILED fallback=freebsd'
                            qotom_watchdog_stop
                        else
                            # Deliberate loader-stage stall, with a bounded software
                            # escape if the independent reset fails to happen.
                            sleep 300
                            echo 'LEANOS-LAB/1 WATCHDOG-NO-RESET fallback=freebsd'
                            qotom_watchdog_stop
                        fi
                    fi
                fi
            else
                echo 'LEANOS-LAB/1 WATCHDOG-WINDOW expired-or-invalid=1 fallback=freebsd'
            fi
        fi
    fi
    if [ "$selected" = "rtc-probe" ]; then
        # Read the clock and exercise expiry without touching watchdog registers.
        if [ -f ($labroot)/boot/grub/watchdog-window.cfg ]; then
            source ($labroot)/boot/grub/watchdog-window.cfg
            set probe_token="watchdog-test-${YEAR}-${MONTH}-${DAY}-${HOUR}-${MINUTE}"
            echo "LEANOS-LAB/1 RTC-BEGIN ${YEAR}-${MONTH}-${DAY}-${HOUR}-${MINUTE}-${SECOND}"
            if qotom_watchdog_window "$probe_token"; then
                echo 'LEANOS-LAB/1 RTC-CURRENT accepted=1'
            else
                echo 'LEANOS-LAB/1 RTC-CURRENT accepted=0'
            fi
            sleep 65
            echo "LEANOS-LAB/1 RTC-END ${YEAR}-${MONTH}-${DAY}-${HOUR}-${MINUTE}-${SECOND}"
            if qotom_watchdog_window "$probe_token"; then
                echo 'LEANOS-LAB/1 RTC-EXPIRED rejected=0'
            else
                echo 'LEANOS-LAB/1 RTC-EXPIRED rejected=1'
            fi
        else
            echo 'LEANOS-LAB/1 RTC-UNAVAILABLE fallback=freebsd'
        fi
    fi
    if [ "$selected" = "reboot-test" ]; then
        echo 'LEANOS-LAB/1 SELECT reboot-test consumed=1'
        sleep 3
        reboot
    fi
else
    echo 'LEANOS-LAB/1 DISARM-FAILED fallback=freebsd'
fi
# Identify the installed disk by its FreeBSD boot partition UUID, not hd order.
for disk in hd0 hd1 hd2 hd3; do
    set candidate=unknown
    if probe --set=candidate --part-uuid ($disk,gpt2); then
        if [ "$candidate" = "@FREEBSD_BOOT_UUID@" ]; then
            echo "LEANOS-LAB/1 CHAIN freebsd disk=$disk"
            set root=($disk)
            if [ "$grub_platform" = "efi" ]; then
                # UEFI: FreeBSD's loader on the disk's EFI system partition.
                chainloader ($disk,gpt1)/efi/freebsd/loader.efi
            else
                chainloader +1
            fi
            boot
        fi
    fi
done
echo 'LEANOS-LAB/1 CHAIN-FAILED manual-recovery-required'
set timeout=-1
menuentry 'Retry FreeBSD default' {
    configfile ($labroot)/boot/grub/grub.cfg
}
